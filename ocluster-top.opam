# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A terminal UI for administering an OCluster scheduler"
description:
  "ocluster-top talks to an ocluster-scheduler over its Cap'n Proto admin API. It shows every pool's capacity, queue length, workers and clients on one screen, refreshing automatically, and lets you pause, unpause, drain, update and forget workers and set client rates from the keyboard."
maintainer: ["Mark Elvers <mark.elvers@tunbury.org>"]
authors: ["Mark Elvers <mark.elvers@tunbury.org>"]
license: "MIT"
depends: [
  "dune" {>= "3.19"}
  "ocaml" {>= "5.0"}
  "notty"
  "lwt"
  "capnp-rpc-lwt" {>= "1.2.3" & < "2.0"}
  "capnp-rpc-unix" {>= "1.2.3" & < "2.0"}
  "ocluster-api" {>= "0.4.0"}
  "cmdliner"
  "logs"
  "fmt"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
